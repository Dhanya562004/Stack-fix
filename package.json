{
  "name": "stackfix-ai",
  "version": "2.0.0",
  "description": "Production-grade AI Debugging Assistant SaaS Platform with Cloud Storage, DevOps, CI/CD, and Automated Testing",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon backend/src/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "ai",
    "debugging",
    "express",
    "react",
    "gemini-api",
    "aws-s3",
    "ci-cd",
    "devops",
    "jest",
    "supertest"
  ],
  "author": "Dhanya",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.654.0",
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.5",
    "supertest": "^7.0.0"
  }
}
